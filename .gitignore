# R and RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# renv: only renv.lock, renv/activate.R and renv/settings.json are tracked
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# raw data is never tracked
data/raw/*
!data/raw/.gitkeep

# large results (regenerated by analysis/NN_*.R from the recorded seeds)
results/sim/
results/pilot/
results/**/*.RData
results/**/*.rda
results/**/*.qs
results/**/*.feather
results/**/*.parquet
results/**/*_large.*

# Quarto intermediate files (report/relatorio.html is tracked)
report/*_files/
report/.quarto/
.quarto/

# package build
*.tar.gz
depprep.Rcheck/

# private Portuguese notes and progress report (separate private repository)
interno/
