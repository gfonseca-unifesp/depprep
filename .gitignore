# R and RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# renv: only renv.lock, renv/activate.R and renv/settings.json are tracked
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# raw data is never tracked
data/raw/*
!data/raw/.gitkeep

# outputs of analysis/ scripts: never tracked (regenerated from recorded seeds)
results/

# simulation protocol and literature review live in the private repository (interno/docs)
docs/

# Quarto intermediate files (report/relatorio.html is tracked)
report/*_files/
report/.quarto/
.quarto/

# package build
*.tar.gz
depprep.Rcheck/

# private Portuguese notes and progress report (separate private repository)
interno/
